import React from 'react';
import axios from 'axios';
import { RxCross2 } from "react-icons/rx";
import { AiOutlineHeart } from 'react-icons/ai';

const LikesInfo = ({ showLikes, setShowLikes, post, handleLikesInfo }) => {

    const [data, setData] = React.useState(null);

    React.useEffect(() => {
        if (post?._id) {
            fetchLikes();
        }
    }, [post._id]);

    const fetchLikes = async () => {
        try {
            const res = await axios.get(`http://localhost:8080/api/feed/likes-data/${post._id}`);
            console.log(res.data);
            setData(res.data);
        } catch (err) {
            console.log(err);
        }
    }

    return (
        <div className='fixed inset-0 z-50 p-8 flex items-center justify-start'>
            <div className='absolute inset-0 bg-black/70' onClick={() => setShowLikes(false)} />

            <div className='bg-white rounded-3xl shadow-2xl py-4 px-2 h-[80vh] w-full max-w-[500px] relative z-10 overflow-hidden animate-fadeIn flex flex-col'>
                <div className='py-4 px-4 flex items-center justify-between border-b border-gray-100 mb-4'>
                    <h1 className='text-xl font-bold text-gray-800'>Likes</h1>
                    <button
                        onClick={() => setShowLikes(!showLikes)}
                        className='cursor-pointer p-2 hover:bg-gray-100 rounded-full transition-colors'
                    >
                        <RxCross2 size={24} />
                    </button>
                </div>

                <div className='flex items-center gap-2 px-6 mb-6'>
                    <div className='p-3 bg-red-50 rounded-full text-red-500'>
                        <AiOutlineHeart size={24} />
                    </div>
                    <div>
                        <p className='text-2xl font-bold text-gray-800'>{data?.Total_Likes || 0}</p>
                        <p className='text-xs text-gray-500 font-medium uppercase tracking-wide'>Total Likes</p>
                    </div>
                </div>

                <div className='flex-1 overflow-y-auto px-6 custom-scrollbar'>
                    {data && data.FetchUserInfos && data.FetchUserInfos.length > 0 ? (
                        <div className='space-y-4'>
                            {data.FetchUserInfos.map((user, index) => (
                                <div key={user._id || index} className='flex items-center gap-4 p-3 hover:bg-gray-50 rounded-xl transition-colors cursor-pointer border border-transparent hover:border-gray-100'>
                                    <div className='w-12 h-12 bg-linear-to-br from-purple-500 to-indigo-500 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-sm'>
                                        {user.name ? user.name.charAt(0).toUpperCase() : '?'}
                                    </div>
                                    <div>
                                        <p className='text-gray-900 font-semibold'>{user.name}</p>
                                        <p className='text-xs text-gray-500'>{new Date(user.createdAt).toLocaleDateString()}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <div className='flex flex-col items-center justify-center h-full text-center p-8'>
                            <div className='w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mb-4 text-gray-300'>
                                <AiOutlineHeart size={40} />
                            </div>
                            <p className='text-gray-500 font-medium text-lg'>No likes yet</p>
                            <p className='text-gray-400 text-sm'>Be the first to like this post!</p>
                        </div>
                    )}
                </div>
            </div>
        </div>
    )
}

export default LikesInfo